# Kubernetes Job template for deferred inference smoke test.
# Waits for model readiness, then sends a real chat completion through
# the full external path and writes evidence to a ConfigMap.
---
apiVersion: batch/v1
kind: Job
metadata:
  name: "inference-smoke-test-{{ model_name | regex_replace('[^a-z0-9-]', '-') }}-{{ report_timestamp }}"
  namespace: default
  labels:
    app: validate-stack
    component: inference-smoke-test
    model: "{{ model_name | regex_replace('[^a-z0-9-]', '-') }}"
spec:
  activeDeadlineSeconds: 3600
  backoffLimit: 0
  template:
    metadata:
      labels:
        app: validate-stack
        component: inference-smoke-test
    spec:
      restartPolicy: Never
      containers:
      - name: smoke-test
        image: curlimages/curl:latest
        command:
        - /bin/sh
        - -c
        - |
          set -e
          MODEL_NAME="{{ model_name }}"
          GATEWAY_URL="{{ gateway_url }}"
          API_KEY="{{ api_key }}"
          CONFIGMAP_NAME="inference-smoke-result-$(echo $MODEL_NAME | tr '/' '-' | tr '[:upper:]' '[:lower:]')"

          echo "=== Inference Smoke Test ==="
          echo "Model: $MODEL_NAME"
          echo "Gateway: $GATEWAY_URL"
          echo "Waiting for model readiness..."

          # Poll vLLM /v1/models until our model appears
          READY=false
          for i in $(seq 1 120); do
            MODELS=$(curl -sf "${GATEWAY_URL}/v1/models" -H "Authorization: Bearer ${API_KEY}" 2>/dev/null || echo "")
            if echo "$MODELS" | grep -q "$MODEL_NAME"; then
              READY=true
              echo "Model ready after $((i * 30))s"
              break
            fi
            echo "Attempt $i: model not yet available, waiting 30s..."
            sleep 30
          done

          if [ "$READY" != "true" ]; then
            echo "FAIL: Model never became ready within 3600s"
            # Write failure to ConfigMap
            kubectl create configmap "$CONFIGMAP_NAME" \
              --from-literal=status=FAIL \
              --from-literal=model="$MODEL_NAME" \
              --from-literal=error="Model never became ready within deadline" \
              --from-literal=timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
              --dry-run=client -o yaml | kubectl apply -f -
            exit 1
          fi

          # Send a real chat completion request through the full path
          START_TIME=$(date +%s%N)
          RESPONSE=$(curl -sf "${GATEWAY_URL}/v1/chat/completions" \
            -H "Authorization: Bearer ${API_KEY}" \
            -H "Content-Type: application/json" \
            -d "{
              \"model\": \"${MODEL_NAME}\",
              \"messages\": [{\"role\": \"user\", \"content\": \"Say hello in exactly one word.\"}],
              \"max_tokens\": 10,
              \"temperature\": 0.1
            }" 2>&1)
          END_TIME=$(date +%s%N)

          TTFT_MS=$(( (END_TIME - START_TIME) / 1000000 ))
          TTFT_S=$(echo "scale=2; $TTFT_MS / 1000" | bc 2>/dev/null || echo "$((TTFT_MS / 1000)).$((TTFT_MS % 1000))")

          # Extract the actual response content
          CONTENT=$(echo "$RESPONSE" | grep -o '"content":"[^"]*"' | head -1 | cut -d'"' -f4 || echo "")

          if [ -n "$CONTENT" ]; then
            echo "SUCCESS: Got response '$CONTENT' in ${TTFT_S}s"
            STATUS="OK"
          else
            echo "FAIL: No content in response: $RESPONSE"
            STATUS="FAIL"
            CONTENT="no-response"
          fi

          # Write evidence to ConfigMap
          kubectl create configmap "$CONFIGMAP_NAME" \
            --from-literal=status="$STATUS" \
            --from-literal=model="$MODEL_NAME" \
            --from-literal=response="$CONTENT" \
            --from-literal=ttft_seconds="$TTFT_S" \
            --from-literal=timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            --dry-run=client -o yaml | kubectl apply -f -

          if [ "$STATUS" = "OK" ]; then
            exit 0
          else
            exit 1
          fi
        resources:
          requests:
            cpu: "100m"
            memory: "64Mi"
          limits:
            cpu: "500m"
            memory: "128Mi"
      serviceAccountName: default

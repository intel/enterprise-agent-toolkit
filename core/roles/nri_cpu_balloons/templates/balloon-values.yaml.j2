# NRI Balloon Policy Configuration
# Multi-Model Support with Dynamic Topology-Aware Balloon Types
#
# This configuration is generated dynamically based on:
# - System topology (NUMA nodes, CPUs)
# - Deployment profile (minimal | standard | observability | full)
# - Model parallelism requirements (TP sizes)

config:
  # Node resource topology tracking
  agent:
    nodeResourceTopology: true
    podResourceAPI: false

  # Enable topology-aware CPU allocation balancing
  allocatorTopologyBalancing: true

  # Control settings
  control:
    rdt:
      enable: false

  # CPU and memory pinning
  pinCPU: true
  pinMemory: false

  # Reserved resources for system and non-model components.
  # Two forms supported:
  #   cpuset:<list>   fixed CPU IDs; requires identical CPU layout on every
  #                   node. Used only when the operator explicitly set
  #                   `nri_reserved_cpu_list` AND the cluster is homogeneous.
  #   <N>             N CPUs; the NRI plugin picks them per-node from local
  #                   topology. Heterogeneity-safe (default for multi-node).
  # NOTE: we read the underscored task-local fact `_nri_reserved_*` on purpose
  # to avoid being shadowed by the empty default in global_config.yaml.
  reservedResources:
{% if nri_reserved_mode == 'cpuset' %}
    cpu: "cpuset:{{ _nri_reserved_cpu_list }}"
{% else %}
    cpu: "{{ _nri_actual_reserved_count }}"
{% endif %}

  # Route every pod without an explicit balloon annotation to the reserved
  # CPU pool. Annotation-bound model pods still go to their vllm-balloon-tpN.
  reservedPoolNamespaces:
    - "*"
    - kube-system

  # Dynamic balloon types generated by gen-balloon-types.py
  # These balloon types enable:
  #   - Multiple models per node with dedicated cores
  #   - Balanced CPU allocation across NUMA nodes
  #   - Support for different tensor parallelism sizes (TP=1,2,4,8)
  #   - Component-based balancing for optimal performance
  balloonTypes:
{{ nri_generated_balloon_types | indent(4, first=True) }}

  # Logging configuration
  log:
    source: true
    debug:
      - policy
    klog:
      skip_headers: true

# Deployment Metadata (for reference)
# Profile: {{ nri_deployment_profile | default('N/A') }}
# Reserved CPUs: {{ nri_actual_reserved_count | default('N/A') }}
# Total CPUs: {{ nri_detected_total_cpus | default('N/A') }}
# NUMA Nodes: {{ nri_detected_numa_nodes | default('N/A') }}
# Max TP Size: {{ nri_max_tp_size | default('N/A') }}
# Workload CPUs: {{ nri_workload_cpus | default('N/A') }}

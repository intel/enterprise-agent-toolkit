apiVersion: openclaw.rocks/v1alpha1
kind: OpenClawInstance
metadata:
  name: [[ name | tojson ]]
  namespace: [[ namespace | tojson ]]
  labels:
    app.kubernetes.io/name: openclaw
    app.kubernetes.io/instance: [[ name | tojson ]]
    intel-stack.io/agent: [[ name | tojson ]]
    intel-stack.io/owner: [[ owner_label | tojson ]]
spec:
  image:
    repository: [[ cfg.openclawImage | tojson ]]
    tag: [[ cfg.openclawTag | tojson ]]
    [% if cfg.openclawDigest %]
    digest: [[ cfg.openclawDigest | tojson ]]
    [% endif %]
  storage:
    persistence:
      enabled: true
      size: "10Gi"
  security:
    networkPolicy:
      enabled: false  # the agent operator owns this namespace's NetworkPolicy
  shareProcessNamespace: false  # CRD default true lets same-UID containers read each other's env
  autoUpdate:
    enabled: false
  config:
    format: json
    # merge keeps runtime-written state; forcePaths keeps the operator-managed trees exact.
    mergeMode: merge
    # gateway.auth.token: a token left by an earlier boot would conflict with trusted-proxy mode.
    forcePaths: ["tools", "plugins", "mcp"[% if cfg.trustedProxies %], "gateway.auth.token"[% endif %]]
    raw:
      agents:
        defaults:
          timeoutSeconds: [[ cfg.agentTimeoutSeconds | int ]]
          model:
            primary: [[ model_ref | tojson ]]
          # The models this agent may switch to (2026.10: modelPolicy replaces agents.defaults.models).
          modelPolicy:
            allow: [[ [model_ref] | tojson ]]
      # Compaction sizes itself from the model's contextWindow and the prompt (2026.10 retired
      # the reserveTokens knobs), so the served size on the model below is what matters.
      [% if cfg.embeddingBaseUrl %]
      memory:
        search:
          provider: "openai-compatible"
          model: [[ cfg.embeddingModel | tojson ]]
          remote:
            baseUrl: [[ cfg.embeddingBaseUrl | tojson ]]
            apiKey: "sk-no-key-needed"
      [% endif %]
      models:
        providers:
          [[ model_provider | tojson ]]:
            api: "openai-completions"
            baseUrl: [[ model_base_url | tojson ]]
            # A secret reference resolved from the env below, not the key itself.
            apiKey: "${OPENAI_API_KEY}"
            [% if cfg.model.allowPrivateNetwork %]
            request:
              allowPrivateNetwork: true
            [% endif %]
            models:
              - id: [[ model_id | tojson ]]
                name: [[ model_name | tojson ]]
                [% if context_window %]
                contextWindow: [[ context_window | int ]]
                [% endif %]
      tools:
        [% for key, value in tools.items() %]
        [[ key | tojson ]]: [[ value | tojson ]]
        [% endfor %]
        deny: [[ (["create_goal", "update_goal", "get_goal"] + (tools_deny or [])) | tojson ]]
        # Every tool in the prompt: 2026.10 hides most behind tool_search/tool_call for local
        # models, which they call wrongly ("Tool sessions_spawn not found").
        toolSearch: false
        [% if web_fetch_proxy %]
        # The proxy env below is operator-set, so web_fetch may trust it.
        web:
          fetch:
            useTrustedEnvProxy: true
        [% endif %]
      # Always emitted (empty when unused) so a JSON patch removes stale entries.
      plugins:
        allow: [[ plugins | tojson ]]
      mcp:
        servers: [[ mcp_servers | tojson ]]
      gateway:
        [% if cfg.trustedProxies %]
        # The platform gateway signs the user in, authorizes them for this agent and names them
        # in x-gw-user; only it can reach this port (NetworkPolicy). Loopback is kubectl port-forward.
        trustedProxies: [[ cfg.trustedProxies | tojson ]]
        auth:
          mode: trusted-proxy
          trustedProxy:
            userHeader: x-gw-user
            allowLoopback: true
            # The platform gateway has already signed the user in and checked they may use this
            # agent, so the dashboard's browser device is approved as that user, without admin.
            deviceAutoApprove:
              enabled: true
        [% endif %]
        controlUi:
          basePath: [[ ("/gw/" ~ cr_namespace ~ "/" ~ name) | tojson ]]
          dangerouslyAllowHostHeaderOriginFallback: false
          [% if cfg.controlUiAllowedOrigins %]
          allowedOrigins: [[ cfg.controlUiAllowedOrigins | tojson ]]
          [% endif %]
        http:
          endpoints:
            chatCompletions:
              enabled: true
  env:
    - name: OPENAI_BASE_URL
      value: [[ model_base_url | tojson ]]
    - name: OPENAI_API_KEY
      valueFrom:
        secretKeyRef:
          name: [[ model_key_secret | tojson ]]
          key: apiKey
    [% if web_fetch_proxy %]
    - name: HTTP_PROXY
      value: [[ web_fetch_proxy | tojson ]]
    - name: HTTPS_PROXY
      value: [[ web_fetch_proxy | tojson ]]
    - name: NO_PROXY
      value: "localhost,127.0.0.1,.svc,.svc.cluster.local,.cluster.local"
    [% endif %]
  gateway:
    existingSecret: [[ (name ~ "-gateway-token") | tojson ]]

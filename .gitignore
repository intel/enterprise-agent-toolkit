# Runtime logs
deploy.log

# Kubespray clone (large, fetched at deploy time)
core/kubespray/

# Vault secrets
core/inventory/metadata/vault.yml
core/inventory/metadata/all.yml

# Auto-generated secrets (contain hashed/plaintext passwords — never commit)
docker/redis/acl.conf
docker/postgres/init.sql
docker/vault.yml

# Auto-generated compose files (built from config.cfg + the engine's model config library at deploy time)
docker/docker-compose.vllm.yml
docker/docker-compose.ovms.yml
docker/.env

# Site-specific inventory — fill in real values locally, then run:
#   git update-index --assume-unchanged <file>
# to prevent accidental commits of real IPs/tokens/passwords.
# These files are tracked as clean templates so fresh checkouts work out of the box.
# core/inventory/agentic-config.cfg   ← tracked as template
# core/inventory/hosts.yaml           ← tracked as template (or generated by parser)
# core/inventory/.vault-passfile      ← tracked as placeholder
# docker/config.cfg                   ← tracked as template
#
# rack-profile.yaml is NOT tracked — it always contains real site topology.
core/inventory/rack-profile.yaml

# Runtime-generated metadata (produced by rack-profile-parser.sh)
# These contain site-specific IPs, hostnames, and topology — never commit.
core/inventory/metadata/k8s-net-fabric.yml
core/inventory/metadata/k8s-net-calico.yml
core/inventory/metadata/vars/ceph-storage.yml
core/inventory/metadata/group_vars/
core/inventory/metadata/rack-scale-flags.env
# all.yml is tracked as a clean template — not gitignored
core/inventory/metadata/bgp-peers/
core/inventory/netplan/
